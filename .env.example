# jACApp root environment — copy to .env and fill the values.
# The real .env is git-ignored; never commit secrets.

# --- Keycloak (authService) ---
KC_DB_NAME=keycloakdb
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=
# Bootstrap admin for the master realm (admin console: http://localhost:8180)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Secret of the confidential jacapp-backend client. The realm import resolves it
# into ${JC_CLIENT_SECRET}; userService and apiGateway receive it as KEYCLOAK_CLIENT_SECRET.
JC_CLIENT_SECRET=

# --- User Service DB ---
POSTGRES_DB=userdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Internal API key (apiGateway -> userService internal registration endpoint) ---
# Any long random string, same value for user-app and api-gateway.
INTERNAL_API_KEY=
